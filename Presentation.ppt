<div class="slide-container">
  <div>
    <div class="slide-badge">Chapter 6 • Performance Benchmarks</div>
    <div class="slide-title">System Performance & Latencies</div>
  </div>
  <div class="slide-body">
    
        <table style="width: 100%; border-collapse: collapse; margin-top: 14pt; font-size: 11.5pt;">
          <tr style="background: #0d3b66; color: #ffffff;">
            <th style="padding: 8pt; text-align: left;">Inspection Pipeline Operation</th>
            <th style="padding: 8pt; text-align: left;">Execution Latency</th>
            <th style="padding: 8pt; text-align: left;">Target Budget</th>
